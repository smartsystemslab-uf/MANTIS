# Copy this file to .env at the repo root to configure live LLM access.
# Required for `mantis --run` (banking agents call a real model). Not needed
# for --validate, --inventory, --generate-schemas, or --evaluate.
UF_NAVIGATOR_API_KEY=
UF_NAVIGATOR_BASE_URL=https://api.ai.it.ufl.edu
UF_NAVIGATOR_MODEL=gpt-oss-20b

# Local banking backend the agents call as tools.
BANKING_BACKEND_BASE_URL=http://127.0.0.1:8000
