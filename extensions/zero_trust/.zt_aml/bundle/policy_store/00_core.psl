// Approvals for critical operations.
// Generated by zt-adk (zt-adk build: operation classification + zt_adk.yaml). Do not edit: rebuild the bundle instead.

// @policy_set zt_adk.core
// @version 1.0.0
// @source zt-adk build: operation classification + zt_adk.yaml
vunit core (pdp_request) {

  // @rule core.critical_risk_requires_approval
  // @nl An operation assessed at critical risk (a critical operation, or a side effect after a tool result or agent message of the same run was flagged) runs only with a human approval.
  // @on_violation MANUAL_REVIEW
  critical_risk: assert always (authz_request && risk.level == "critical" -> approval.valid);

}
