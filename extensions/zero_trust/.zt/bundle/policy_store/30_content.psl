// User input.
// Generated by zt-adk (zt-adk build: zt_adk.yaml content). Do not edit: rebuild the bundle instead.

// @policy_set zt_adk.content.input
// @version 1.0.0
// @source zt-adk build: zt_adk.yaml content
// @runtime native,gateway
vunit content_input (input_message) {

  // @rule content.input.prompt-injection
  // @nl A user message with prompt-injection patterns is refused before any agent sees it.
  // @on_violation DENY
  input_injection: assert never (input_received && input.prompt_injection_detected);

  // @rule content.input.api_key
  // @nl A user message containing api_key is flagged.
  // @on_violation FLAG
  input_api_key: assert never (input_received && input.contains.api_key);

  // @rule content.input.private_key
  // @nl A user message containing private_key is flagged.
  // @on_violation FLAG
  input_private_key: assert never (input_received && input.contains.private_key);

  // @rule content.input.max-length
  // @nl A user message is at most 100000 characters.
  // @on_violation DENY
  input_length: assert never (input_received && input.length > 100000);

}

// User-visible output.
// Generated by zt-adk (zt-adk build: zt_adk.yaml content). Do not edit: rebuild the bundle instead.

// @policy_set zt_adk.content.output
// @version 1.0.0
// @source zt-adk build: zt_adk.yaml content
// @runtime native,gateway
vunit content_output (output_message) {

  // @rule content.output.api_key
  // @nl User-visible content containing api_key is withheld.
  // @on_violation DENY
  output_api_key: assert never (output_emitted && output.contains.api_key);

  // @rule content.output.credit_card
  // @nl User-visible content containing credit_card is withheld.
  // @on_violation DENY
  output_credit_card: assert never (output_emitted && output.contains.credit_card);

  // @rule content.output.email
  // @nl User-visible content containing email is flagged.
  // @on_violation FLAG
  output_email: assert never (output_emitted && output.contains.email);

  // @rule content.output.iban
  // @nl User-visible content containing iban is flagged.
  // @on_violation FLAG
  output_iban: assert never (output_emitted && output.contains.iban);

  // @rule content.output.phone
  // @nl User-visible content containing phone is flagged.
  // @on_violation FLAG
  output_phone: assert never (output_emitted && output.contains.phone);

  // @rule content.output.private_key
  // @nl User-visible content containing private_key is withheld.
  // @on_violation DENY
  output_private_key: assert never (output_emitted && output.contains.private_key);

  // @rule content.output.ssn
  // @nl User-visible content containing ssn is withheld.
  // @on_violation DENY
  output_ssn: assert never (output_emitted && output.contains.ssn);

}

// Messages between agents.
// Generated by zt-adk (zt-adk build: zt_adk.yaml content). Do not edit: rebuild the bundle instead.

// @policy_set zt_adk.content.agent_message
// @version 1.0.0
// @source zt-adk build: zt_adk.yaml content
// @runtime native,gateway
vunit content_agent_message (agent_message) {

  // @rule content.agent-message.prompt-injection
  // @nl A request from one agent to another with prompt-injection patterns is flagged (the run becomes tainted).
  // @on_violation FLAG
  message_injection: assert never (agent_message_sent && message.prompt_injection_detected);

}

// Tool results.
// Generated by zt-adk (zt-adk build: zt_adk.yaml content). Do not edit: rebuild the bundle instead.

// @policy_set zt_adk.content.tool_result
// @version 1.0.0
// @source zt-adk build: zt_adk.yaml content
// @runtime native,gateway
vunit content_tool_result (tool_result) {

  // @rule content.tool-result.prompt-injection
  // @nl A tool result with prompt-injection patterns is flagged (the run becomes tainted: later side effects need approval).
  // @on_violation FLAG
  result_injection: assert never (tool_result_received && result.prompt_injection_detected);

  // @rule content.tool-result.api_key
  // @nl A tool result containing api_key is flagged.
  // @on_violation FLAG
  result_api_key: assert never (tool_result_received && result.contains.api_key);

  // @rule content.tool-result.private_key
  // @nl A tool result containing private_key is flagged.
  // @on_violation FLAG
  result_private_key: assert never (tool_result_received && result.contains.private_key);

}

// Model requests.
// Generated by zt-adk (zt-adk build: discovered built-ins). Do not edit: rebuild the bundle instead.

// @policy_set zt_adk.content.model_request
// @version 1.0.0
// @source zt-adk build: discovered built-ins
// @runtime native,gateway
vunit content_model (model_request) {

  // @rule content.model.declared-functions
  // @nl A model request declares only functions the bundle lists for the agent (no injected tools).
  // @on_violation DENY
  model_functions: assert never (model_requested && request.undeclared_functions);

  // @rule content.model.declared-builtins
  // @nl A model request enables only the model-side capabilities of the agent's own built-in tools.
  // @on_violation DENY
  model_builtins: assert never (model_requested && request.undeclared_builtins);

}
