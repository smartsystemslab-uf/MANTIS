.venv/
.env
.pytest_cache/
__pycache__/
*.pyc
*.db
.runtime/
.coverage
.DS_Store
*.egg-info/
mlruns/
.claude/
~$*
# Per-run campaign output directories accumulate unboundedly; the fixed
# reference examples (run_artifacts/<name>/ for baselines and the five wp5_*
# attacks) stay tracked, campaign sweeps and one-off verify_* scratch runs
# don't.
run_artifacts/campaign_run_*/
run_artifacts/verify_*/
# Scratch configs the minimal UI (mantis --ui) writes per validate/run action.
configs/ui_generated/
# Per-trial scratch dirs of the extended scenario campaign; the recorded evidence is
# results/extended_*.json (each trial carries its own tools, outcome, and database snapshot).
run_artifacts/ext_*/
run_artifacts/camp_*/
