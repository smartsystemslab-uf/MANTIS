App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "front_office_monitoring": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "front_office_router"
    },
    {
      "agent": "front_office_router",
      "event": "transfer",
      "to": "front_office_transaction_workflow"
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_transaction_context",
      "args": {
        "transaction_id": "TXN-1001"
      }
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer high risk out of band amount new counterparty device change sanctions compliance manual review"
      }
    },
    {
