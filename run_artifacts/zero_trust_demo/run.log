App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "front_office_monitoring": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "front_office_router"
    },
    {
      "agent": "front_office_router",
      "event": "transfer",
      "to": "front_office_transaction_workflow"
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_transaction_context",
      "args": {
        "transaction_id": "TXN-1001"
      }
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer out to external account high risk device change geography new counterparty policies"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_call",
      "tool": "submit_manual_review",
      "args": {
        "case_type": "manual_review",
        "payload": "{\"decision\":\"manual_review\",\"confidence\":0.85,\"manual_review_needed\":true,\"approval_scope\":null,\"rationale\":\"Monitoring flagged high risk due to new external counterparty EXT-998, amount $9200 exceeding typical spend, device change, and location anomaly. Fraud assessment indicates high likelihood of account takeover or sophisticated fraud. Compliance policies require manual review, beneficiary verification via MFA, device fingerprint confirmation, IP geolocation match, sanctions screening, enhanced due diligence, and account freeze pending approval.\",\"next_step\":\"Route to manual fraud & compliance review, freeze account until approval, and conduct full AML/KYC checks.\"}"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_result",
      "tool": "submit_manual_review",
      "result": {
        "case_id": "MR-46EEF40A",
        "case_type": "manual_review",
        "status": "open",
        "created_at": "2026-10-12T19:10:36.146174+00:00"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "result",
      "key": "fo_decision_report",
      "value": {
        "decision": "manual_review",
        "confidence": 0.85,
        "manual_review_needed": true,
        "approval_scope": null,
        "rationale": "Monitoring flagged high risk due to new external counterparty EXT-998, amount $9200 exceeding typical spend, device change, and location anomaly. Fraud assessment indicates high likelihood of account takeover or sophisticated fraud. Compliance policies require manual review, beneficiary verification via MFA, device fingerprint confirmation, IP geolocation match, sanctions screening, enhanced due diligence, and account freeze pending approval.",
        "next_step": "Route to manual fraud & compliance review, freeze account until approval, and conduct full AML/KYC checks."
      }
    }
  ]
}
