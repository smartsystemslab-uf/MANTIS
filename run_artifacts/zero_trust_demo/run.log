App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "front_office_monitoring": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "front_office_router"
    },
    {
      "agent": "front_office_router",
      "event": "transfer",
      "to": "front_office_transaction_workflow"
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_transaction_context",
      "args": {
        "transaction_id": "TXN-1001"
      }
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer high risk new external counterparty device change unusual geography $9200 USD, pre-trade compliance, AML threshold, KYC verification, sanctions check new correspondent bank, manual review policy, source of funds verification requirement"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer > $5000 high risk, device change, unusual geography, new external counterparty, manual review policy, AML threshold"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_call",
      "tool": "submit_manual_review",
      "args": {
        "case_type": "high_risk_transaction",
        "payload": "Transaction TXN-1001 from account CHK-001 to EXT-998, amount $9,200 USD. Flags: new external counterparty, device change, unusual geography (IP country differs from Gainesville, FL), amount > $5,000 and above customer average ($120) with max $7,500. Risk score 65, monitoring confidence 0.8. High fraud, compliance risks; recommended manual review, source of funds verification, beneficiary confirmation, device validation, IP check, and sanctions screening."
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_result",
      "tool": "submit_manual_review",
      "result": {
        "case_id": "MR-96103991",
        "case_type": "high_risk_transaction",
        "status": "open",
        "created_at": "2026-09-14T21:08:21.937865+00:00"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "result",
      "key": "fo_decision_report",
      "value": {
        "decision": "manual_review",
        "confidence": 0.8,
        "manual_review_needed": true,
        "approval_scope": "hold",
        "rationale": "High risk transaction flagged for multiple fraud and compliance triggers (large amount, new external counterparty, device change, unusual geography, amount above normal pattern). Monitoring, fraud, and compliance systems all indicate high confidence in risk, warranting escalation.",
        "next_step": "1. Place transaction on temporary hold.\n2. Notify compliance team to perform manual review.\n3. Verify source of funds through bank statements or internal ledger.\n4. Confirm beneficiary details against known references.\n5. Validate device identity (challenge question/OTP).\n6. Cross‑check IP geolocation with customer’s historical locations.\n7. Ensure sanctions screening against recipient and correspondent bank.\n8. Contact customer via trusted channel to confirm intent before re‑approval."
      }
    }
  ]
}
