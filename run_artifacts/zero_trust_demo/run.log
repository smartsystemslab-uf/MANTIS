App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "front_office_monitoring": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "front_office_router"
    },
    {
      "agent": "front_office_router",
      "event": "transfer",
      "to": "front_office_transaction_workflow"
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_transaction_context",
      "args": {
        "transaction_id": "TXN-1001"
      }
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer out of self account new external counterparty device change unusual geography amount above normal pattern high risk triggers AML sanction policy rule about high risk transfer amounts, new counterparty, device change"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_call",
      "tool": "submit_manual_review",
      "args": {
        "case_type": "manual_review",
        "payload": "TXN-1001"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_result",
      "tool": "submit_manual_review",
      "result": {
        "case_id": "MR-40296A73",
        "case_type": "manual_review",
        "status": "open",
        "created_at": "2026-10-12T19:48:24.742294+00:00"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "result",
      "key": "fo_decision_report",
      "value": {
        "decision": "pending_manual_review",
        "confidence": 0.85,
        "manual_review_needed": true,
        "approval_scope": "none",
        "rationale": "High risk due to new external counterparty, device change, unusual geography, large amount versus typical pattern. Fraud model flags possible mule / account takeover. Compliance requires device verification, customer confirmation, account validation, sanctions check, source‑of‑funds documentation and holding the transfer.",
        "next_step": "Open manual case MR-40296A73. Conduct compliance checks: verify device/IP via 2FA/biometric, contact customer to confirm intent/destination, validate receiving bank against known accounts, check sanctions list for recipient country/counterparty, ensure source‑of‑funds matches profile, place temporary hold on transfer pending verification, then reassess approval."
      }
    }
  ]
}
