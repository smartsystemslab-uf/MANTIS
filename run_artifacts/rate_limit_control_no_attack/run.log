App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "front_office_monitoring": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "front_office_router"
    },
    {
      "agent": "front_office_router",
      "event": "transfer",
      "to": "front_office_transaction_workflow"
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_transaction_context",
      "args": {
        "transaction_id": "TXN-1001"
      }
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer high risk new external counterparty device change unusual geography sanctions compliance AML KYC verification outbound transfer policy"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "outbound wire transfer compliance rules anti money laundering new counterparty device change unusual geography"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_call",
      "tool": "submit_manual_review",
      "args": {
        "case_type": "transaction_review",
        "payload": "{\"transaction_id\":\"TXN-1001\",\"amount\":9200.0,\"from_account\":\"CHK-001\",\"to_account\":\"EXT-998\",\"risk_score\":65,\"triggers\":[\"new_external_counterparty\",\"device_change\",\"unusual_geography\",\"amount_exceeds_customer_pattern\"],\"customer_id\":\"CUST-001\"}"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_result",
      "tool": "submit_manual_review",
      "result": {
        "case_id": "MR-D78417C6",
        "case_type": "transaction_review",
        "status": "open",
        "created_at": "2026-09-24T16:54:05.480779+00:00"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "result",
      "key": "fo_decision_report",
      "value": {
        "decision": "hold",
        "confidence": 0.85,
        "manual_review_needed": true,
        "approval_scope": "none",
        "rationale": "High‐risk indicators: new external counterparty, device change, unusual geography, and amount far above customer’s typical patterns (4× average daily volatility). Monitoring and fraud scores are 65/100 with 85% confidence, and compliance flags a need for out‑of‑band authorization, counterparty verification, and sanctions screening. The transaction should not be approved automatically and must remain pending while a compliance specialist completes the required checks.",
        "next_step": "Submit to compliance for manual review (case MR-D78417C6) and hold the wire transfer until authorization and source‑of‑funds verification are confirmed."
      }
    }
  ]
}
