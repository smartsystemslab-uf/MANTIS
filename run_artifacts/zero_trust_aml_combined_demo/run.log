App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "aml_office_structuring_investigation": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "aml_office_router"
    },
    {
      "agent": "aml_office_router",
      "event": "transfer",
      "to": "aml_investigation_workflow"
    },
    {
      "agent": "aml_investigator",
      "event": "tool_call",
      "tool": "detect_structuring",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "aml_investigator",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "aml_investigator",
      "event": "result",
      "key": "aml_investigation_summary",
      "value": {
        "investigation_status": "open",
        "findings": "Suspicious structuring activity detected: three separate deposits of $4,000 each from external source EXT-777 into the principal checking account CHK-001 within a 7‑day window, exceeding the $10,000 threshold for aggregate deposits. Pattern is atypical for the customer's profile.",
        "risk_score": 0.75,
