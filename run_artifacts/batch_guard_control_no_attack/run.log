App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "back_office_clean": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "back_office_router"
    },
    {
      "agent": "back_office_router",
      "event": "transfer",
      "to": "back_office_eod_workflow"
    },
    {
      "agent": "validation_checkpoint_agent",
      "event": "tool_call",
      "tool": "validate_eod_readiness",
      "args": {
        "batch_id": "EOD-2026-04-21-CLEAN"
      }
    },
    {
      "agent": "eod_processing_agent",
      "event": "tool_call",
      "tool": "get_eod_batch",
      "args": {
        "batch_id": "EOD-2026-04-21-CLEAN"
      }
    },
    {
      "agent": "ledger_update_agent",
      "event": "tool_call",
      "tool": "apply_ledger_updates",
      "args": {
        "batch_id": "EOD-2026-04-21-CLEAN",
        "posting_instructions": "{\"batch_id\":\"EOD-2026-04-21-CLEAN\",\"total_amount\":18250.55,\"item_count\":43}"
      }
    },
    {
      "agent": "reconciliation_agent",
      "event": "tool_call",
      "tool": "get_reconciliation_data",
      "args": {
        "batch_id": "EOD-2026-04-21-CLEAN"
      }
    },
    {
      "agent": "report_writing_agent",
      "event": "tool_call",
      "tool": "store_report",
      "args": {
        "batch_id": "EOD-2026-04-21-CLEAN",
        "report_body": "EOD Batch EOD-2026-04-21-CLEAN processed successfully. Total amount posted: $18,250.55 across 43 items. Ledger updated. Reconciliation matched with zero difference. Batch archived and stakeholders notified."
      }
    },
    {
      "agent": "report_writing_agent",
      "event": "tool_result",
      "tool": "store_report",
      "result": {
        "report_id": "RPT-868B4091",
        "batch_id": "EOD-2026-04-21-CLEAN",
        "status": "generated",
        "created_at": "2026-09-21T20:39:03.976234+00:00"
      }
    },
    {
      "agent": "report_writing_agent",
      "event": "result",
      "key": "bo_report_output",
      "value": {
        "report_summary": "Batch EOD-2026-04-21-CLEAN processed: $18,250.55 posted across 43 items, ledger updated, reconciliation match with zero difference. Archived and stakeholders notified.",
        "report_id": "RPT-868B4091",
        "downstream_notes": "Batch archived, final reporting completed, stakeholders informed of successful EOD closure."
      }
