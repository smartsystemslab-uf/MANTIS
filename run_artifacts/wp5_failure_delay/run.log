App "citi_banking_adk" can transfer between agents but has no context_cache_config. Every transfer swaps the system instruction and the tool set, so the request prefix changes and the whole prompt is re-sent uncached after each transfer. Set context_cache_config on the app to give each agent its own cache.
{
  "front_office_monitoring": [
    {
      "agent": "user_proxy_agent",
      "event": "transfer",
      "to": "front_office_router"
    },
    {
      "agent": "front_office_router",
      "event": "transfer",
      "to": "front_office_transaction_workflow"
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_transaction_context",
      "args": {
        "transaction_id": "TXN-1001"
      }
    },
    {
      "agent": "transaction_monitoring_agent",
      "event": "tool_call",
      "tool": "get_customer_context",
      "args": {
        "customer_id": "CUST-001"
      }
    },
    {
      "agent": "compliance_agent",
      "event": "tool_call",
      "tool": "search_policies",
      "args": {
        "query": "wire transfer high risk red flags new external counterparty device change unusual geography AML sanctions compliance rules for USD transfer >$5,000 to external party, KYC verification, sanctions screening, PEP, AML screening, transaction monitoring policy, high risk customer medium risk, manual review threshold"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_call",
      "tool": "submit_manual_review",
      "args": {
        "case_type": "manual_review",
        "payload": "TXN-1001: pending wire transfer of USD 9,200 from Ava Patel (CHK-001) to external counterparty EXT-998. Risk factors: large amount exceeding daily limits, new counterparty, device change, unusual geography. Customer risk level: medium, overall risk score: 65.\n"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "tool_result",
      "tool": "submit_manual_review",
      "result": {
        "case_id": "MR-85A3771E",
        "case_type": "manual_review",
        "status": "open",
        "created_at": "2026-09-14T20:29:26.517044+00:00"
      }
    },
    {
      "agent": "decision_making_agent",
      "event": "result",
      "key": "fo_decision_report",
      "value": {
        "decision": "manual_review",
        "confidence": 0.85,
        "manual_review_needed": true,
        "approval_scope": "none",
        "rationale": "Transaction TXN-1001 exhibits high‑risk flags: large amount exceeding daily limits, new external counterparty, device change, and unusual geography. The customer’s medium risk profile combined with a risk score of 65 triggers a high‑level review per monitoring, fraud, and compliance inputs. Manual investigation is required to verify customer intent, device authenticity, counterparty legitimacy, and to satisfy AML/KYC and sanctions screening obligations.",
        "next_step": "Open a manual review case (MR-85A3771E), gather additional KYC and device evidence, conduct enhanced due‑diligence on EXT‑998, perform sanctions screening, document findings, and determine approval or denial based on regulatory thresholds."
      }
    }
  ]
}
